# Copier ce fichier en ".env" puis remplir les valeurs

# --- Serveur ---
PORT=3000
JWT_SECRET=change-moi-par-une-longue-phrase-secrete

# --- MySQL (valeurs par défaut de XAMPP) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cvmatchia
# Sur Railway : MYSQL_URL remplace DB_HOST, DB_PORT, DB_USER et DB_PASSWORD
# MYSQL_URL=${{MySQL.MYSQL_URL}}

# --- Fichiers des CV ---
# Par défaut server/uploads/. Sur Railway : le chemin du disque permanent (volume), ex. /data/uploads
# DOSSIER_UPLOADS=/data/uploads

# --- E-mail sur Railway (Brevo) ---
# Railway bloque l'envoi SMTP (Gmail) : on passe par l'API de Brevo.
# Si BREVO_API_KEY est rempli, Brevo est utilisé à la place de Gmail.
# EMAIL_EXPEDITEUR : adresse vérifiée comme expéditeur dans le compte Brevo.
# BREVO_API_KEY=
# EMAIL_EXPEDITEUR=

# --- E-mail sur l'ordinateur (Gmail) ---
# 1. Activer la validation en 2 étapes sur le compte Google
# 2. Créer un "mot de passe d'application" : https://myaccount.google.com/apppasswords
# 3. Coller ce mot de passe de 16 lettres ci-dessous (sans espaces)
# Si ces deux lignes sont vides, le code OTP s'affiche seulement dans la console.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Claude (IA) ---
# Clé à créer sur https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# --- Deep matching (modele/service.py) ---
# Si le service ne tourne pas, le score retombe sur le calcul par mots-clés.
MODELE_URL=http://127.0.0.1:8000
